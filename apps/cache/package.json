{
  "name": "micro-image-cache",
  "version": "1.0.0",
  "main": "dist/index.js",
  "repository": "git@github.com:veksen/micro-image-cache.git",
  "author": "Jean-Philippe Sirois <jp@veksen.net>",
  "license": "MIT",
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "benchmark": "vite-node benchmark/proxy.bench.ts",
    "benchmark:history": "vite-node benchmark/history.ts"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "fastify": "^5.11.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "dotenv": "^17.4.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
