{
  "name": "@micro-image/plugin-react",
  "version": "0.0.0",
  "keywords": [
    "unplugin",
    "vite-plugin",
    "react",
    "image"
  ],
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "default": "./dist/vite.mjs"
    }
  },
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@babel/parser": "^8.1.3",
    "@babel/traverse": "^8.1.3",
    "magic-string": "^0.30.21",
    "unplugin": "^3.7.0"
  },
  "devDependencies": {
    "@micro-image/tsconfig": "*",
    "@types/node": "^24.13.3",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  }
}
